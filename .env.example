# =============================================
# VARIÁVEIS DE AMBIENTE — ShareRoom
# =============================================
#
# ATENÇÃO: Nunca commite o arquivo .env real no GitHub!
# Este arquivo (.env.example) é o template — sem valores reais.
#
# No Netlify, configure cada variável em:
# Site Settings → Environment Variables
#
# Para desenvolvimento local:
# 1. Copie este arquivo: cp .env.example .env.local
# 2. Preencha os valores reais no .env.local
# 3. O .env.local já está no .gitignore
#
# =============================================

# URL do seu projeto LiveKit Cloud
# Formato: wss://seu-projeto-xxxxx.livekit.cloud
VITE_LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud

# API Key do LiveKit (encontrada no dashboard do LiveKit Cloud)
# BACKEND ONLY — nunca use VITE_ nesta variável
LIVEKIT_API_KEY=APIKEYAQUI

# API Secret do LiveKit (encontrada no dashboard do LiveKit Cloud)
# BACKEND ONLY — nunca use VITE_ nesta variável
LIVEKIT_API_SECRET=SECRETAQUI
